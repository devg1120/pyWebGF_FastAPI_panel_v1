# views.py （グラフ領域内目次配置版）
import os
import glob
import json
import panel as pn
from natsort import natsorted
import pandas as pd

from models import get_base_dir_path, DASHBOARD_REGISTRY
from charts import make_matplotlib_figure, make_anomaly_figure

class TabRenderer:
    """各タブのグラフグリッドおよび画面レイアウトをレンダリングするクラス"""
    def __init__(self, state):
        self.state = state
        
        # 💡 通常モニター用コンテナの構成変更
        self.main_toc_pane = pn.pane.HTML(width=260, sizing_mode="stretch_height")
        self.main_graph_grid = pn.GridBox(ncols=2, sizing_mode="stretch_width")
        
        # 「左に目次」「右にグラフ」を横並びにするメインレイアウト（これをapp.pyに渡す）
        self.main_tab_layout = pn.Row(
            self.main_toc_pane,
            self.main_graph_grid,
            sizing_mode="stretch_width"
        )
        
        # 他のタブは従来通りGridBox単体
        self.dashboard_graph_grid = pn.GridBox(ncols=2, sizing_mode="stretch_width")
        self.anomaly_graph_grid = pn.GridBox(ncols=2, sizing_mode="stretch_width")

    def add_to_dashboard(self, filename, desc):
        """ダッシュボードへのお気に入り登録処理"""
        exists = any(i["yyyymm"] == self.state.yyyymm and i["dd"] == self.state.dd and i["switch"] == self.state.switch and i["filename"] == filename and i["base_id"] == self.state.base_id for i in DASHBOARD_REGISTRY)
        if not exists:
            DASHBOARD_REGISTRY.append({
                "base_id": self.state.base_id, "mode": self.state.mode, "yyyymm": self.state.yyyymm, "dd": self.state.dd,
                "start_dd": self.state.start_dd, "end_dd": self.state.end_dd, "switch": self.state.switch,
                "filename": filename, "desc": desc
            })
            pn.state.notifications.success(f"🔌 {filename.replace('.csv','')} を登録しました！")
            self.render_dashboard_tab()

    def delete_dashboard_item(self, idx):
        if 0 <= idx < len(DASHBOARD_REGISTRY):
            DASHBOARD_REGISTRY.pop(idx)
            self.render_all()

    def render_all(self):
        """全タブを一括再描画"""
        self.render_main_tab()
        self.render_dashboard_tab()
        self.render_anomaly_tab()

    def render_main_tab(self):
        self.main_graph_grid.clear()
        self.main_graph_grid.ncols = self.state.cols
        
        actual_base = get_base_dir_path(self.state.base_id)
        target_dir = os.path.join(actual_base, self.state.yyyymm, self.state.dd, self.state.switch)
        
        info_json_path = os.path.join(target_dir, "info.json")
        info_dic = {}
        if os.path.exists(info_json_path):
            with open(info_json_path, 'r', encoding='utf-8') as f:
                info_dic = json.load(f)

        csv_filenames = natsorted([os.path.basename(f) for f in glob.glob(os.path.join(target_dir, "*.csv"))])
        if not csv_filenames:
            self.main_toc_pane.object = ""
            self.main_graph_grid.append(pn.pane.Markdown("### ⚠️ CSVファイルが見つかりません。"))
            return

        # ─── 💡 修正箇所：グラフ領域の左側に表示する「固定目次HTML」を動的生成 ───
        # スムーズスクロール用のCSSスタイルとスタイリッシュなメニュー枠を構築
        toc_html = """
        <div style="position: sticky; top: 10px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 15px; max-height: 85vh; overflow-y: auto; font-size: 13px; line-height: 1.6;">
            <h4 style="margin-top: 0; color: #333; border-bottom: 2px solid #002b36; padding-bottom: 5px; font-size: 14px;">📌 インターフェース目次</h4>
            <ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
        """
        

        for fname in csv_filenames:
            if_name = fname.replace('.csv', '')
            desc = info_dic.get(if_name, {}).get("desc", "")
            label = f"<b>{if_name}</b><br><span style='color: #666; font-size: 11px;'>{desc}</span>" if desc else f"<b>{if_name}</b>"

            # 💡 修正箇所：ID属性に頼らず、画面上の「タイトル文字列」を全全探索してスクロールさせる最強のJSロジック
            toc_html += f"""
                <li style="margin-bottom: 12px; border-bottom: 1px dashed #e9ecef; padding-bottom: 6px;">
                    <a href="#" style="color: #0072B2; text-decoration: none; display: block;"
                       onclick="
                           (function() {{
                               var searchTitle = '🔌 {if_name}';
                               var foundElement = null;

                               // 画面上のすべてのShadow DOMを再帰的に全探索するヘルパー関数
                               function searchElements(root) {{
                                   if (foundElement) return;
                                   var elements = root.querySelectorAll('*');
                                   for (var i = 0; i < elements.length; i++) {{
                                       var el = elements[i];
                                       // 要素のテキスト、または直近の親要素のテキストにタイトルが含まれているか判定
                                       if (el.textContent && el.textContent.trim().indexOf(searchTitle) === 0) {{
                                           foundElement = el;
                                           return;
                                       }}
                                       // 影のDOM（Shadow Root）があればさらにその奥深くを探索
                                       if (el.shadowRoot) {{
                                           searchElements(el.shadowRoot);
                                       }}
                                   }}
                               }}

                               // まずは通常のドキュメント全体をスキャン
                               searchElements(document);

                               // タイトルが見つかったら、そのカードの親階層へ向けてスムーズスクロールを発火
                               if (foundElement) {{
                                   var targetCard = foundElement.closest('.bk-panel-Card') || foundElement.closest('.card') || foundElement;
                                   targetCard.scrollIntoView({{behavior: 'smooth', block: 'start'}});
                               }} else {{
                                   console.log('目次対象のグラフ要素が見つかりませんでした: ' + searchTitle);
                               }}
                           }})();
                           return false;
                       ">
                        {label}
                    </a>
                </li>
            """


            # ─── グラフカードの描画処理 ───
            fig = make_matplotlib_figure(
                actual_base, self.state.mode, self.state.yyyymm, self.state.dd, self.state.start_dd, self.state.end_dd,
                self.state.switch, fname, self.state.cols, self.state.start_hour, self.state.end_hour, speed=info_dic.get(if_name, {}).get("speed", ""), desc=desc
            )
            
            is_registered = any(i["yyyymm"] == self.state.yyyymm and i["dd"] == self.state.dd and i["switch"] == self.state.switch and i["filename"] == fname and i["base_id"] == self.state.base_id for i in DASHBOARD_REGISTRY)

            if is_registered:
                reg_btn = pn.widgets.Button(name="⏳ 登録中", button_type="light", disabled=True, width=160, align="end")
            else:
                reg_btn = pn.widgets.Button(name="＋ ダッシュボード登録", button_type="primary", width=160, align="end")
            
            def create_click_handler(f_name=fname, d_desc=desc, button=reg_btn):
                def handle_click(event):
                    button.disabled = True
                    button.button_type = "light"
                    button.name = "⏳ 登録中"
                    self.add_to_dashboard(f_name, d_desc)
                return handle_click

            if not is_registered:
                reg_btn.on_click(create_click_handler())
            
            card_content = pn.Column(
                pn.pane.Matplotlib(fig, tight=True, format="png", dpi=110, sizing_mode="stretch_width"),
                pn.layout.Divider(),
                reg_btn,
                sizing_mode="stretch_width"
            )
            
            # 💡 修正箇所：目次からジャンプできるように、stylesheetsを使ってカード自体に「HTMLのID属性」を設定
            self.main_graph_grid.append(pn.Card(
                card_content,
                title=f"🔌 {if_name}",
                header_background="#0072B2",
                header_color="white",
                collapsible=False,
                margin=10,
                sizing_mode="stretch_width",
                stylesheets=[f":host {{ id: card-{if_name}; scroll-margin-top: 20px; }}"]
            ))

        toc_html += "</ul></div>"
        # 生成したHTMLを左側の目次ペインへ反映
        self.main_toc_pane.object = toc_html

    def render_dashboard_tab(self):
        self.dashboard_graph_grid.clear()
        self.dashboard_graph_grid.ncols = self.state.cols
        if not DASHBOARD_REGISTRY:
            self.dashboard_graph_grid.append(pn.pane.Markdown("### 📌 ダッシュボードに登録されたグラフはありません。"))
            return

        for idx, item in enumerate(DASHBOARD_REGISTRY):
            fig = make_matplotlib_figure(
                get_base_dir_path(item["base_id"]), self.state.mode, self.state.yyyymm, self.state.dd, self.state.start_dd, self.state.end_dd,
                item["switch"], item["filename"], self.state.cols, self.state.start_hour, self.state.end_hour, desc=item["desc"]
            )
            del_btn = pn.widgets.Button(name="× 削除", button_type="danger", width=80, align="end")
            del_btn.on_click(lambda e, i=idx: self.delete_dashboard_item(i))
            
            card_content = pn.Column(
                pn.pane.Matplotlib(fig, tight=True, format="png", dpi=110, sizing_mode="stretch_width"),
                pn.layout.Divider(),
                del_btn,
                sizing_mode="stretch_width"
            )
            
            self.dashboard_graph_grid.append(pn.Card(
                card_content,
                title=f"⭐ [{item['base_id']}] {item['switch']} - {item['filename']}",
                header_background="#D55E00",
                header_color="white",
                collapsible=False,
                margin=10,
                sizing_mode="stretch_width"
            ))

    def render_anomaly_tab(self):
        self.anomaly_graph_grid.clear()
        self.anomaly_graph_grid.ncols = self.state.cols
        if not (self.state.start_dd and self.state.end_dd and self.state.switch):
            self.anomaly_graph_grid.append(pn.pane.Markdown("### 🔍 条件を指定してください。"))
            return

        actual_base = get_base_dir_path(self.state.base_id)
        scan_date_dir = os.path.join(actual_base, pd.to_datetime(self.state.start_dd).strftime("%Y%m"), pd.to_datetime(self.state.start_dd).strftime("%d"), self.state.switch)
        csv_filenames = natsorted([os.path.basename(f) for f in glob.glob(os.path.join(scan_date_dir, "*.csv"))])

        if not csv_filenames:
            self.anomaly_graph_grid.append(pn.pane.Markdown("### ⚠️ CSVファイルが見つかりません。"))
            return

        from detectors import AnomalyDetectors
        logics_map = AnomalyDetectors.get_available_logics()
        inv_logics_map = {v: k for k, v in logics_map.items()}
        selected_logic_key = inv_logics_map.get(self.state.anomaly_logic, "stat_threshold")

        for fname in csv_filenames:
            fig = make_anomaly_figure(
                actual_base, self.state.start_dd, self.state.end_dd, self.state.switch, fname,
                selected_logic_key, self.state.start_hour, self.state.end_hour, self.state.cols
            )
            self.anomaly_graph_grid.append(pn.Card(
                pn.pane.Matplotlib(fig, tight=True, format="png", dpi=110, sizing_mode="stretch_width"),
                title=f"🧠 {fname.replace('.csv','')}", header_background="#CC79A7", header_color="white", collapsible=False, margin=10, sizing_mode="stretch_width"
            ))
